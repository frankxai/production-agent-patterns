# Public HTTPS domain of the Railway operator. Never use *.railway.internal from Vercel.
RAILWAY_API_URL=http://127.0.0.1:4100

# Server-only. Must equal Railway OPERATOR_API_KEY.
RAILWAY_API_TOKEN=replace-with-64-random-characters

# Separate human gate for the single-operator cockpit.
COCKPIT_ACCESS_TOKEN=replace-with-a-different-64-random-characters

# Exact browser origin. Required in production for mutation origin checks.
APP_ORIGIN=http://localhost:3000

OPERATOR_TIMEOUT_MS=65000
