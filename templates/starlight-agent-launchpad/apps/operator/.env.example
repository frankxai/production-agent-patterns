NODE_ENV=development
HOST=0.0.0.0
PORT=4100

# Generate independent 64-character values. Never share the signing secret with Vercel.
OPERATOR_API_KEY=replace-with-64-random-characters
RECEIPT_SIGNING_SECRET=replace-with-another-64-random-characters
RECEIPT_SIGNING_KEY_ID=launchpad-local-v1
# Optional JSON map of retired key IDs to secrets kept only for verification.
RECEIPT_VERIFICATION_KEYS={}

# Local simulation is explicit. Set false when RUNTIME_ADAPTER=http is proven.
RUNTIME_ADAPTER=mock
ALLOW_MOCK_RUNTIME=true

# Required only for RUNTIME_ADAPTER=http.
AGENT_RUNTIME_URL=https://runtime.example.com/v1/runs
AGENT_RUNTIME_API_KEY=replace-with-runtime-secret
RUNTIME_TIMEOUT_MS=60000

# PostgreSQL is mandatory when NODE_ENV=production; omitted locally uses memory.
DATABASE_URL=
MIGRATE_ON_START=true
# Must be strictly greater than RUNTIME_TIMEOUT_MS / 1000 + 30.
IDEMPOTENCY_LEASE_SECONDS=180

ALLOWED_WORKFLOWS=research-brief
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
TRUST_PROXY=false
